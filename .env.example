# Required for live agent runs. Get it from https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Optional: agent effort ("auto", "low", "medium", "high", "xhigh"). Default: auto
EXA_AGENT_EFFORT=auto

# Optional: port for the API server. Default: 8787
PORT=8787

# Optional: where the Vite dev server proxies /api. Default: http://localhost:8787
API_TARGET=http://localhost:8787
